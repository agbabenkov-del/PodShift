<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Style x:Key="SkinWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="shell:WindowChrome.WindowChrome" Value="{x:Null}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#171717"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SkinFrameStyle" TargetType="Border"/>
    <Style x:Key="SkinFrameInnerStyle" TargetType="Border"/>
    <Style x:Key="SkinCaptionStyle" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="SkinHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SkinMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#626262"/>
    </Style>
    <Style x:Key="SkinCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#DADADA"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="SkinCardInnerStyle" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SkinButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#F3F3F3"/>
        <Setter Property="Foreground" Value="#171717"/>
        <Setter Property="BorderBrush" Value="#CFCFCF"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                            <Rectangle x:Name="FocusOutline" Margin="4" RadiusX="2" RadiusY="2"
                                       Stroke="#000080" StrokeDashArray="1,1" Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#E8E8E8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#DADADA"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#767676"/>
                            <Setter TargetName="Face" Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SkinCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SkinButtonStyle}"/>
    <Style x:Key="SkinFooterStyle" TargetType="Border"/>
    <Style x:Key="SkinSelectorStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
