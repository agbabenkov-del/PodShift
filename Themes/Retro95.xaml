<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Style x:Key="SkinWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                                    CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SkinFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="2,2,0,0"/>
    </Style>
    <Style x:Key="SkinFrameInnerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#404040"/>
        <Setter Property="BorderThickness" Value="0,0,2,2"/>
    </Style>
    <Style x:Key="SkinCaptionStyle" TargetType="Border">
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="Background" Value="#000080"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,2,2,0"/>
        <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style x:Key="SkinHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#000080"/>
    </Style>
    <Style x:Key="SkinMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#404040"/>
    </Style>
    <Style x:Key="SkinCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#808080"/>
        <Setter Property="BorderThickness" Value="2,2,0,0"/>
    </Style>
    <Style x:Key="SkinCardInnerStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,2,2"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="SkinButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TopBevel" BorderBrush="#FFFFFF" BorderThickness="2,2,0,0">
                        <Border x:Name="BottomBevel" Background="{TemplateBinding Background}"
                                BorderBrush="#404040" BorderThickness="0,0,2,2">
                            <Grid>
                                <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Rectangle x:Name="FocusOutline" Margin="3"
                                           Stroke="{TemplateBinding Foreground}" StrokeDashArray="1,1"
                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TopBevel" Property="BorderBrush" Value="#404040"/>
                            <Setter TargetName="BottomBevel" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Label" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#707070"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SkinCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SkinButtonStyle}">
        <Setter Property="Width" Value="23"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="SkinFooterStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#808080"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style x:Key="SkinSelectorStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="White" BorderBrush="#808080" BorderThickness="2,2,0,0">
                            <Border BorderBrush="White" BorderThickness="0,0,2,2">
                                <ContentPresenter Margin="5,2,25,2" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </Border>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Border Width="22" HorizontalAlignment="Right" Background="#C0C0C0"
                                                BorderBrush="#404040" BorderThickness="0,0,1,1" Margin="2">
                                            <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="Black"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Rectangle x:Name="FocusOutline" Margin="4,4,27,4" Stroke="Black" StrokeDashArray="1,1"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                            <Border Background="White" BorderBrush="Black" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
