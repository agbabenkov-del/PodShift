<Window x:Class="PodShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PodShift" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource SkinWindowStyle}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Style="{DynamicResource SkinFrameStyle}"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border Style="{DynamicResource SkinFrameInnerStyle}">
            <StackPanel>
                <Border Style="{DynamicResource SkinCaptionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="17" Height="16" Margin="0,0,6,0">
                                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="6" Height="6" Fill="White"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="3" Height="7" Fill="White"/>
                                <Rectangle Canvas.Left="10" Canvas.Top="2" Width="6" Height="6" Fill="White"/>
                                <Rectangle Canvas.Left="10" Canvas.Top="7" Width="3" Height="7" Fill="White"/>
                            </Canvas>
                            <TextBlock Text="PodShift" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{DynamicResource SkinCaptionButtonStyle}" Margin="0,0,3,0"
                                Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="Свернуть" ToolTip="Свернуть">
                            <Path Data="M 0,0 H 9" Stroke="Black" StrokeThickness="2" Margin="0,6,0,0"/>
                        </Button>
                        <Button Grid.Column="2" Style="{DynamicResource SkinCaptionButtonStyle}"
                                Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="Закрыть" ToolTip="Закрыть">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="Black" StrokeThickness="2"/>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Margin="20">
                    <TextBlock Text="PodShift" Style="{DynamicResource SkinHeadingStyle}"/>
                    <TextBlock Text="Быстрое переключение AirPods на Windows"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource SkinMutedTextStyle}"/>
                    <Border Margin="0,20,0,0" Style="{DynamicResource SkinCardStyle}">
                        <Border Style="{DynamicResource SkinCardInnerStyle}">
                            <StackPanel>
                                <TextBlock x:Name="DeviceNameText" Text="AirPods не выбраны"
                                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusText" Text="Нажми «Найти AirPods»"
                                           Margin="0,8,0,0" MinHeight="34" TextWrapping="Wrap"
                                           Style="{DynamicResource SkinMutedTextStyle}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <Button x:Name="FindButton" Content="_Найти AirPods" Margin="0,18,0,0"
                            Style="{DynamicResource SkinButtonStyle}" Click="FindButton_Click"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConnectButton" Content="Подключить к _ПК" IsEnabled="False"
                                Style="{DynamicResource SkinButtonStyle}" Click="ConnectButton_Click"
                                ToolTip="Открыть настройки Windows для подключения"/>
                        <Button x:Name="DisconnectButton" Grid.Column="2" Content="_Отключить" IsEnabled="False"
                                Style="{DynamicResource SkinButtonStyle}" Click="DisconnectButton_Click"
                                ToolTip="Открыть настройки Windows для отключения"/>
                    </Grid>
                    <Border Margin="0,18,0,0" Style="{DynamicResource SkinFooterStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PodShift 0.1" VerticalAlignment="Center" FontSize="11"
                                       Style="{DynamicResource SkinMutedTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="Скин:" Margin="8,0,6,0" VerticalAlignment="Center"
                                       Style="{DynamicResource SkinMutedTextStyle}"/>
                            <ComboBox x:Name="SkinSelector" Grid.Column="2" Width="116"
                                      Style="{DynamicResource SkinSelectorStyle}"
                                      SelectionChanged="SkinSelector_SelectionChanged"
                                      AutomationProperties.Name="Скин программы"
                                      ToolTip="Выбранный скин сохраняется после закрытия.">
                                <ComboBoxItem Content="Обычный"/>
                                <ComboBoxItem Content="Ретро 95"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
