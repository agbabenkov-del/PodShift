<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PodShift</AssemblyName>
    <RootNamespace>PodShift</RootNamespace>
    <ApplicationIcon>Assets\podshift.ico</ApplicationIcon>
    <Version>0.2.0-alpha</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>PodShift</Product>
    <Description>One-click AirPods switching for Windows.</Description>
    <Authors>PodShift contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/agbabenkov-del/PodShift</RepositoryUrl>
  </PropertyGroup>
</Project>
